          "content": "Animação ligada ao gameplay",
          "sourceFactIds": [
            "sentinel"
          ]
        },
        {
          "role": "body",
          "content": "O código do player examinado inclui idle, walk, shoot, hurt e death, timing de reprodução e reações. Qualidade depende de poses legíveis, peso, timing e eventos de gameplay — não apenas de quantidade de frames.",
          "sourceFactIds": [
            "sentinel"
          ]
        }
