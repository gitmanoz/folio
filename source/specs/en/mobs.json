        },
        {
          "role": "body",
          "content": "MOBS is the engineering platform of the Missão ecosystem. It separates institutional knowledge, project configuration and deterministic materialization so that new products can reuse established capabilities.",
          "sourceFactIds": [
            "mobs"
          ]
        }
      ]
    },
    {
