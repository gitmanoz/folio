        {
          "role": "title",
          "content": "What exists",
          "sourceFactIds": [
            "mobs"
          ]
        },
        {
          "role": "body",
          "content": "Context resolution, documentation, derived asset exports, SEO/PWA generation, release/deploy proposals, Narrative and Web Experience are represented by platform modules. Proposals are not automatic deployment.",
          "sourceFactIds": [
            "mobs"
          ]
        }
      ]
    },
