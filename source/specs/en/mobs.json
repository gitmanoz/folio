      "slots": [
        {
          "role": "title",
          "content": "The problem",
          "sourceFactIds": [
            "mobs"
          ]
        },
        {
          "role": "body",
          "content": "Duplicating infrastructure for each product loses decisions and increases future maintenance. The platform treats documented knowledge and clear contracts as reusable inputs.",
          "sourceFactIds": [
            "mobs"
          ]
        }
      ]
    },
    {
      "id": "f-section-1",
      "order": 3,
      "purpose": "Architecture in practice",
      "chapterId": "f-section-1",
      "frameIntent": "explain-list",
      "figurativeLayer": "schematic",
      "visualPlanes": [
        "text"
      ],
      "density": "balanced",
