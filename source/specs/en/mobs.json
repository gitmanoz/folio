      "slots": [
        {
          "role": "title",
          "content": "Architecture in practice",
          "sourceFactIds": [
            "mobs"
          ]
        },
        {
          "role": "body",
          "content": "Project context → MOBS Core → engines and generators → validators. Agent Runtime Integration adds a boundary between institutional authority and external executors.",
          "sourceFactIds": [
            "mobs"
          ]
        },
        {
          "role": "bullet",
          "content": "Authority — documents own meaning and responsibility.",
          "sourceFactIds": [
            "mobs"
          ]
        },
        {
          "role": "bullet",
          "content": "Execution — consumers implement their runtime without redefining the institution.",
          "sourceFactIds": [
            "mobs"
          ]
        },
        {
          "role": "bullet",
          "content": "Evidence — structural validation and provenance keep outputs inspectable.",
          "sourceFactIds": [
            "mobs"
          ]
        }
      ]
    },
    {
      "id": "f-section-2",
      "order": 4,
      "purpose": "What exists",
      "chapterId": "f-section-2",
      "frameIntent": "explain-list",
